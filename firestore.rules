rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidContact(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.role is string && (data.role == 'Contractor' || data.role == 'Client' || data.role == 'Team');
    }

    match /contacts/{contactId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidContact(request.resource.data);
      allow update: if isSignedIn() && isValidContact(request.resource.data) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'email', 'phone', 'whatsapp', 'telegram', 'address', 'notes'])
      );
      allow delete: if isSignedIn();
    }

    function isValidProject(data) {
      return data.name is string && data.name.size() > 0 && 
             data.status in ['Planning', 'In Progress', 'Completed', 'On Hold'];
    }

    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidProject(request.resource.data);
      allow update: if isSignedIn() && isValidProject(request.resource.data);
      allow delete: if isSignedIn();
    }

    function isValidTask(data) {
      return data.title is string && data.title.size() > 0 &&
             data.status in ['Pending', 'In Progress', 'Resolved'];
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidTask(request.resource.data);
      allow update: if isSignedIn() && isValidTask(request.resource.data);
      allow delete: if isSignedIn();
    }

    match /communications/{commId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /financials/{finId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /travelLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    match /registrations/{regId} {
      allow read: if isSignedIn(); // We want to allow queries by phoneNumber
      allow create: if true; 
    }
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }
  }
}
